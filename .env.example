# 复制为 .env 并按需修改；生产环境务必重新生成密钥
DJANGO_SECRET_KEY=please-change-me-to-a-random-50-chars-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# 凭据加密密钥（Fernet key，44 位 urlsafe base64）。
# 留空则退化为由 SECRET_KEY 派生，生产环境建议显式配置并妥善保管。
CREDENTIAL_ENCRYPTION_KEY=

# 数据库：sqlite（默认）或 postgres
DB_ENGINE=sqlite
DB_NAME=dbmgr
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# 业务参数
CREDENTIAL_ROTATE_INTERVAL_HOURS=12
CREDENTIAL_PASSWORD_LENGTH=24
TCP_PROBE_TIMEOUT_SECONDS=3
REQUEST_TIMING_SLOW_THRESHOLD_MS=500
